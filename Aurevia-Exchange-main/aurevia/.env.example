# Required server-only application configuration.
DATABASE_URL=
DIRECT_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Required for TOTP enrollment. Generate a stable 32-byte Base64 key with `openssl rand -base64 32`.
# Keep it server-only and stable; losing it makes enrolled authenticator secrets unreadable.
TOTP_ENCRYPTION_KEY=

# Required only for Playwright E2E. Both URLs must target the same local PostgreSQL database ending in _e2e.
AUREVIA_E2E_DATABASE_URL=
AUREVIA_E2E_DIRECT_URL=

# Optional public application configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Enable only after aureviaexchanged.dpdns.org DNS and HTTPS are verified in Render.
AUREVIA_CUSTOM_DOMAIN_VERIFIED=
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key only; no browser Supabase client is currently wired.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Test-only loopback HTTP override; never enable in production.
AUREVIA_E2E_ALLOW_HTTP_PROVIDER=

# Required for first configured-admin sign-in or provisioning with `npm run db:seed`.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required server-only Storage configuration when private file workflows are enabled.
# Never expose the service-role key through NEXT_PUBLIC_* or client-side code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Brevo SMTP email configuration. Port 587 requires STARTTLS.
# SMTP_USER, SMTP_PASSWORD, and SMTP_FROM must be supplied by the deployment secret manager.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Existing Resend configuration remains available as a compatibility fallback when SMTP is absent.
SUPPORT_EMAIL=aureviainvest@gmail.com
COMPLAINTS_EMAIL=
SUPPORT_PHONE=+1 (210) 504-7697

# Required before encrypted saved REAL withdrawal destinations can be created.
# Generate a stable 32-byte key with `openssl rand -base64 32` and store it in the deployment secret manager.
# Keep the same key across deployments and backups; losing it makes saved destinations unreadable.
WITHDRAWAL_DESTINATION_ENCRYPTION_KEY=

# Email-code fallback and KYC phone verification provider configuration.
# Permanent accounts are created only after email verification completes.
VERIFICATION_CODE_SECRET=
RESEND_API_KEY=
VERIFICATION_EMAIL_FROM=noreply@aureviaexchanged.dpdns.org
# Optional fallback for REAL-mode KYC phone verification when Akedly is disabled or unavailable.
# Twilio Verify is preferred for international SMS; destination countries and geo permissions are managed in Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Termii remains an optional fallback provider.
TERMII_API_KEY=
TERMII_SENDER_ID=
# Use the account-specific HTTPS base URL shown in the Termii dashboard (defaults to Nigeria).
TERMII_BASE_URL=https://api.ng.termii.com
# Legacy custom verification delivery integrations (optional compatibility).
VERIFICATION_EMAIL_API_URL=
VERIFICATION_EMAIL_API_KEY=
VERIFICATION_SMS_API_URL=
VERIFICATION_SMS_API_KEY=
# Legacy compatibility settings; these values no longer gate signup or phone verification.
REGISTRATION_VERIFICATION_ENABLED=
PHONE_VERIFICATION_REQUIRED=

# Optional server-only values for Akedly V2 registration and phone verification.
# Configure the pipeline backend callback URL as https://<application-host>/api/webhooks/akedly
# and frontend callback URL as https://<application-host>/auth/akedly/callback.
# Keep every value server-only; never use NEXT_PUBLIC_* names for these credentials.
# Remains disabled until controlled live delivery and webhook verification succeed.
AKEDLY_ENABLED=false
AKEDLY_API_KEY=
AKEDLY_PIPELINE_ID=
AKEDLY_WIDGET_ID=
AKEDLY_PUBLIC_KEY=
AKEDLY_WIDGET_SECRET=
AKEDLY_WEBHOOK_SECRET=

# Optional server-only market data. Existing Alpaca/Finnhub support remains available.
# ALPACA_API_KEY and ALPACA_SECRET_KEY (or ALPACA_API_SECRET) are required for Alpaca data and paper-account checks.
# FINNHUB_API_KEY enables the Finnhub fallback.
# These providers are rate-limited and support different instruments; only supported instrument categories are queried.
# Confirm your provider plan permits your intended production display/use before enabling the license acknowledgment.
# In Render set MARKET_DATA_DISPLAY_LICENSES_CONFIRMED=true only after verifying that entitlement.
# Credentials are server-only and must never use NEXT_PUBLIC_* names.
# MARKET_DATA_API_URL/KEY are reserved and unused.
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
MARKET_DATA_DISPLAY_LICENSES_CONFIRMED=false

# Optional read-only Alpaca paper-account health. These secrets stay server-side.
ALPACA_PROVIDER=alpaca
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets/v2
# Backward-compatible aliases: ALPACA_BASE_URL and ALPACA_API_SECRET.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper endpoint only; live endpoints are rejected.
# Paper-order enablement is separate from live execution; defaults to disabled.
ALPACA_PAPER_ORDERS_ENABLED=false
# Live execution must remain disabled.
REAL_EXECUTION_ENABLED=false

# External payment processing remains disabled.

# Optional application runtime configuration.
PORT=
MARKET_TICK_MS=1000

# Required by the Vercel once-per-minute simulated market cron job.
CRON_SECRET=

# Required only for the local PostgreSQL service in docker-compose.yml.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=


# Central server-only AI gateway. OpenRouter is the default; paid model IDs are rejected.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
AI_PROVIDER=openrouter
AI_MODEL=openrouter/free
# Optional Gemini/Groq fallbacks require both a free-model allowlist entry and a model ID.
AI_BACKUP_PROVIDERS=
AI_FREE_MODEL_ALLOWLIST=
GEMINI_FREE_MODEL=
GROQ_FREE_MODEL=
# Required only when administrators submit encrypted AI credentials through the command center.
# Generate once with `openssl rand -base64 32`; preserve across deployments and backups.
AI_SECRETS_ENCRYPTION_KEY=

# Optional server-only DEMO AI recommendations. Disabled by default; no AI request submits an order.
DEMO_AI_ENABLED=false
DEMO_AI_STRATEGIES=momentum,mean_reversion
DEMO_AI_SUPPORTED_SYMBOLS=
DEMO_AI_RISK_PER_TRADE=0.01
DEMO_AI_MAX_POSITION_USD=500
DEMO_AI_ENTRY_THRESHOLD=0.005
DEMO_AI_STOP_LOSS_PERCENT=0.02
DEMO_AI_TAKE_PROFIT_PERCENT=0.04
DEMO_AI_FEE_RATE=0.0015
DEMO_AI_SPREAD_BPS=2
DEMO_AI_SLIPPAGE_BPS=5
DEMO_AI_EVALUATION_INTERVAL_SECONDS=300


# Optional external news feed (server-only). Never expose via NEXT_PUBLIC_*.
# Federal Reserve RSS uses a fixed public XML URL (see lib/news-feed/sources.ts).
GNEWS_API_KEY=
# GNews free/non-commercial plan is for local development and testing only.
# Set AUREVIA_GNEWS_ALLOW_PRODUCTION=true only with an authorized commercial plan.
AUREVIA_GNEWS_ALLOW_PRODUCTION=
# Shared secret for GET /api/cron/news-feed and other scheduled jobs.
CRON_SECRET=
