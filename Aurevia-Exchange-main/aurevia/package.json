    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/react-query": "5.104.1",
    "bcryptjs": "2.4.3",
    "bitcoinjs-lib": "7.0.1",
    "bottleneck": "^2.19.5",
    "clsx": "2.1.1",
    "ethers": "6.17.0",
    "gsap": "^3.15.0",
    "html2canvas-pro": "1.6.7",
    "jose": "5.9.6",
    "jspdf": "^4.2.1",
    "libphonenumber-js": "1.13.14",
    "lightweight-charts": "5.2.1",
    "lru-cache": "^11.5.3",
    "lucide-react": "0.468.0",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "nodemailer-secure": "npm:nodemailer@10.2.1",
    "otplib": "^13.5.0",
    "p-retry": "^9.0.0",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.2.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "^3.10.1",
    "sharp": "0.35.5",
    "socket.io": "4.8.1",
