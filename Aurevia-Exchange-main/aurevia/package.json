{
  "name": "aurevia-invest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "AUREVIA_NEXT_DIST_DIR=.next-dev tsx server.ts",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/playwright.mjs test",
    "test:e2e:isolated": "node tests/e2e/run-isolated.mjs",
    "test:browser:smoke": "node tests/browser/smoke.mjs",
    "tools:install": "bash scripts/install-tools.sh",
    "tools:verify": "bash scripts/verify-tools.sh",
    "browsers:install": "bash scripts/install-browsers.sh",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@next/env": "14.2.35",
    "@prisma/client": "5.22.0",
    "@react-three/drei": "^10.7.9",
