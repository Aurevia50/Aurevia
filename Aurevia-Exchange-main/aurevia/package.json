    "node": ">=22.13.0 <23"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "esbuild@0.23.1": true,
    "esbuild@0.21.5": true,
    "unrs-resolver@1.12.2": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
