{
  "name": "aurevia-invest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "AUREVIA_NEXT_DIST_DIR=.next-dev tsx server.ts",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/playwright.mjs test",
    "test:e2e:isolated": "node tests/e2e/run-isolated.mjs",
    "test:e2e:ui": "node scripts/playwright.mjs test --ui",
    "test:e2e:headed": "node scripts/playwright.mjs test --headed",
    "test:e2e:debug": "node scripts/playwright.mjs test --debug",
    "test:e2e:report": "node scripts/playwright.mjs show-report",
    "test:e2e:chromium": "node tests/e2e/run-isolated.mjs --project=chromium",
    "test:e2e:all-browsers": "node scripts/test-e2e-all-browsers.mjs",
    "test:e2e:api-routes": "node tests/e2e/run-isolated.mjs tests/e2e/api-route-coverage.spec.ts",
    "test:e2e:accessibility": "node tests/e2e/run-isolated.mjs tests/e2e/accessibility.spec.ts",
    "test:e2e:lighthouse": "AUREVIA_LIGHTHOUSE_AUDIT=1 node tests/e2e/run-isolated.mjs tests/e2e/lighthouse.audit.ts",
    "test:browser:smoke": "node tests/browser/smoke.mjs",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:e2e:isolated",
    "tools:install": "bash scripts/install-tools.sh",
    "tools:verify": "bash scripts/verify-tools.sh",
    "browsers:install": "bash scripts/install-browsers.sh",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@next/env": "14.2.35",
    "@prisma/client": "5.22.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/react-query": "5.104.1",
    "bcryptjs": "2.4.3",
    "bitcoinjs-lib": "7.0.1",
    "bottleneck": "^2.19.5",
    "clsx": "2.1.1",
    "ethers": "6.17.0",
    "gsap": "^3.15.0",
    "html2canvas-pro": "1.6.7",
    "jose": "5.9.6",
    "jspdf": "^4.2.1",
    "libphonenumber-js": "1.13.14",
    "lightweight-charts": "5.2.1",
    "lru-cache": "^11.5.3",
    "lucide-react": "0.468.0",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "nodemailer-secure": "npm:nodemailer@10.2.1",
    "otplib": "^13.5.0",
    "p-retry": "^9.0.0",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.2.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "^3.10.1",
    "sharp": "0.35.5",
    "socket.io": "4.8.1",
    "socket.io-client": "^4.8.1",
    "svix": "^1.99.1",
    "swiper": "^14.4.0",
    "tailwind-merge": "2.5.5",
    "three": "^0.172.0",
    "tsx": "4.23.15",
    "web-push": "^3.6.7",
    "zod": "4.6.7",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^22.10.5",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.172.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lighthouse": "^13.6.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.29",
    "prisma": "5.22.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "esbuild@0.23.1": true,
    "esbuild@0.21.5": true,
    "unrs-resolver@1.12.2": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
